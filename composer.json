{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "samuel-nunes/laravel-ddd-skeleton-identity",
    "type": "project",
    "description": "Cloneable Laravel DDD skeleton with an embedded Identity Platform.",
    "keywords": ["laravel", "ddd", "identity", "oauth", "oidc"],
    "license": "MIT",
    "require": {
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-redis": "*",
        "php": "^8.3.16",
        "inertiajs/inertia-laravel": "^3.1",
        "laravel/framework": "^13.8",
        "laravel/tinker": "^3.0",
        "samuel-nunes/laravel-ddd-toolkit": "^1.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12",
        "psalm/plugin-laravel": "^3.15",
        "vimeo/psalm": "^6.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1 --timeout=0\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php vendor/bin/phpunit"
        ],
        "quality:architecture": "@php artisan ddd:check",
        "quality:format": "pint --test",
        "quality:phpstan": "phpstan analyse",
        "security:taint": "psalm --taint-analysis --no-cache",
        "security:taint-self-test": "@php -r \"fwrite(STDERR, 'The vulnerable taint fixture is scheduled for M12 and is not implemented in M0.'.PHP_EOL); exit(2);\"",
        "quality": [
            "@quality:architecture",
            "@quality:format",
            "@quality:phpstan",
            "@security:taint",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.3.16"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
